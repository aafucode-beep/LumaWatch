# ===== 应用鉴权（单用户） =====
# 登录口令（首次部署请务必修改）
APP_PASSWORD=change-me-please
# JWT 签名密钥（请替换为随机长字符串）
SECRET_KEY=replace-with-a-long-random-secret
# 令牌有效期（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ===== 数据库 =====
# 默认 SQLite；如需 PostgreSQL 可改为 postgresql+psycopg://user:pass@host/db
DATABASE_URL=sqlite:///./data/app.db

# ===== 大模型（OpenAI 兼容接口，默认 MiniMax CN） =====
LLM_BASE_URL=https://api.minimaxi.com/v1
LLM_API_KEY=your-minimax-api-key
LLM_MODEL=MiniMax-Text-01
# 单次提取的最大输入字符数（控制成本）
LLM_MAX_INPUT_CHARS=48000
LLM_TIMEOUT=120

# ===== 爬取 =====
# 每个探测任务最多抓取的页面数
CRAWL_MAX_PAGES=12
# 单页超时（秒）
CRAWL_TIMEOUT=30
# 抓取间隔（秒），礼貌限速
CRAWL_DELAY=1.5
# 是否遵守 robots.txt
CRAWL_RESPECT_ROBOTS=true
# 是否使用 Playwright 渲染 JS 页面
CRAWL_USE_PLAYWRIGHT=true
CRAWL_USER_AGENT=LightingIntelBot/1.0 (+personal research)

# ===== CORS（前端地址，逗号分隔；开发默认放行本地） =====
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
